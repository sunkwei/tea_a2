{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mingw",
      "displayName": "Windows x64 / MinGW-w64",
      "inherits": "base",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-mingw",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "posix",
      "displayName": "Linux / macOS (Unix Makefiles)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "arm64-linux",
      "displayName": "Linux aarch64 (cross from x86_64 host)",
      "description": "Uses cmake/toolchains/aarch64-linux-gnu.cmake; fully static binary with the CA bundle embedded. Override the toolchain with TEA_AARCH64_PREFIX.",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "binaryDir": "${sourceDir}/build-arm64",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win64-mingw-cross",
      "displayName": "Windows x64 / MinGW-w64 (cross from a POSIX host)",
      "description": "Uses cmake/toolchains/mingw-w64-x86_64.cmake. On Windows itself use the native mingw preset.",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake",
      "binaryDir": "${sourceDir}/build-win64",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw",
      "configurePreset": "mingw"
    },
    {
      "name": "posix",
      "configurePreset": "posix"
    },
    {
      "name": "arm64-linux",
      "configurePreset": "arm64-linux"
    },
    {
      "name": "win64-mingw-cross",
      "configurePreset": "win64-mingw-cross"
    }
  ]
}
