# 任务单（task order）
# ===========================================================================
# 填好这个文件，交给队列，它就排进队列等着做。
#
# 格式（简单文本，不是 YAML）：
#   * 一行一个「键: 值」；# 开头是注释；空行忽略
#   * 键下面的缩进行，是上一个键的续行（要做的内容就写在这里）
#   * 列表可以缩进多行写，也可以用逗号分隔
#   * 不认识的键会被指出来（带着行号），不会悄悄丢掉
#
# 填完怎么交：
#   python3 sched/task_server.py --submit-order <这个文件>
#   交上去以后：GET /api/tasks/{id} 看它，/api/tasks 看队列
#
# 不想用这个文件也行：直接 POST /api/tasks，下面每一项都对应一个字段。
# ===========================================================================

# ---------------------------------------------------------------------------
# 【要做什么】—— 必填
# ---------------------------------------------------------------------------
title: 把 README 的构建例子跑一遍
prompt: |
  把 tea_a2 的 README 里的构建例子真的跑一遍，
  遇到问题就记下来，最后给我一份清单。

# ---------------------------------------------------------------------------
# 【在哪儿做】
# 留空 = 队列自己的工作区（~/.tea_agent/task-workspace，不碰别人的 checkout）
# 写目录（绝对路径）或工作区 id 都行
# ---------------------------------------------------------------------------
workspace: /home/sunkw/work/git/tea_a2

# 这个任务额外可以碰的目录（工作区本身一直可以；这里只放宽这一个任务）
allow_paths:
  - /tmp
  - /home/sunkw/work/git/tea_a2/build

# ---------------------------------------------------------------------------
# 【用谁跑】
# 留空 = 队列的默认 provider（额度闸门看的就是它）
# ---------------------------------------------------------------------------
provider: minimax
model: MiniMax-M3.1-Flash

# ---------------------------------------------------------------------------
# 【什么时候做】
# 留空 = 尽快（额度有余量就开工）
# ---------------------------------------------------------------------------
priority: 0                 # 越大越先做（默认 0）
not_before: +5              # '+5' 五小时后；'23:30' 今天 23:30（已经过了就尽快做）
                           # 还有 '+30m'、'+2d'、'2026-10-24T09:00:00Z'（绝对时间，UTC）

# ---------------------------------------------------------------------------
# 【归档与查找】—— 业务自己用；队列可以按 tags / business_id 过滤
# ---------------------------------------------------------------------------
tags:
  - 文档
  - 验证
business_id: DOC-2026-1023

# 留空 = 按内容自动算：同一份任务单交两次不会排两次
idempotency_key:

# 其它业务元数据（自由键值，原样存进任务记录）
meta:
  owner: sunwei
  review_by: 2026-10-30
