# 邮件看门狗（mail_watch.py）的配置
# ===========================================================================
# 复制成 ~/.tea_agent/mail/config（或者跑 python3 sched/mail_watch.py init），
# 填上 address / password 就行。
#
# 格式：一行一个「键: 值」；# 开头是注释；值后面「空格 + #」也是注释；
# 以 | 结尾的键，下面缩进的行是它的正文（rules / signature 用）。
# 写错键会带行号报错，不会悄悄不生效。
#
# 这是通用 IMAP：任何一家（QQ / Outlook / 自建 / Gmail）都只是 host / port / password 不同。
#
# Gmail 的话 password 是**应用专用密码**（16 位，像 abcd efgh ijkl mnop，不是账号密码）：
# https://myaccount.google.com/apppasswords ，前提是开了两步验证。
# 但这条路 2026 年已经很不好走 —— Google 的风控看账号/设备/IP，新机器第一次连就可能被拦，
# 而且这个脚本从没对着真账号跑过（见 docs/integrations.md 的「现状」）。想少踩坑就先用
# 别的邮箱试：把 host / port 换成你有的那一家，别的键都不用动。
# ===========================================================================

# ---------------------------------------------------------------------------
# 【邮箱】—— 必填
# ---------------------------------------------------------------------------
address: you@gmail.com
password: abcd efgh ijkl mnop

host: imap.gmail.com
port: 993
mailbox: INBOX

# ---------------------------------------------------------------------------
# 【动作】
# 不需要我参与的：贴这个标签（默认还会移出收件箱，见 archive）
# 需要我参与的：贴这个标签，留在收件箱里，并写出草稿（见 drafts）
# ---------------------------------------------------------------------------
label_done: tea/done
label_needs_me: tea/needs-me

archive: yes          # 不需要我参与的，移出收件箱（Gmail 里就是去掉 \Inbox，不删）
mark_seen: yes        # 判读过的信件标为已读
drafts: on            # 需要我回复时，把草稿放进 Gmail 草稿箱（**不会发出去**）
drafts_folder:        # 留空 = 按 host 猜（Gmail 是 [Gmail]/Drafts）

# ---------------------------------------------------------------------------
# 【节奏】
# ---------------------------------------------------------------------------
lookback_days: 3      # 第一次跑往回看几天
max_per_round: 10     # 一轮最多判几封（新信优先）
interval: 300         # 常驻时多少秒一轮

# ---------------------------------------------------------------------------
# 【判读】
# 借 agent 的 /api/llm/chat，所以 provider / key / 模型都在 provider.yaml 里，
# 这里只说要哪一个。留空 = agent 的默认 provider 和它的首选模型。
# ---------------------------------------------------------------------------
agent: http://127.0.0.1:8383
provider: deepseek
model: deepseek-flash

# 我的额外规则：原样塞进判读提示词。写得越具体，判得越准。
rules: |
  · 老板（boss@example.com）和家人的信一律算需要我，不看内容。
  · 开发票、续费、到期提醒：需要我，动作 label。
  · 各种周报、CI 通知、GitHub/知乎/B 站通知：不需要我，归档。
  · 带「面试」「报价」「合同」字样的，紧急。

# 草稿的落款
signature: |
  孙科

# ---------------------------------------------------------------------------
# 【出口】—— 只在该我参与时说话
# notify: telegram | webhook | file | none
#   telegram 要 token 和 chat id；webhook 收到一段 JSON（text + 分类/发件人/链接）；
#   file 只写 ~/.tea_agent/mail/digest/YYYY-MM-DD.md（安静，适合先跑几天看看）；
#   none 什么都不发。
# ---------------------------------------------------------------------------
notify: telegram
telegram_token:
telegram_chat:

# webhook: https://example.com/hooks/mail

# ---------------------------------------------------------------------------
# 【要真干活的时候】
# 判读出「要实际做一件事」（follow_up 非空）→ 排进 tea_a2 的队列，
# 做完由队列/机器人通知我。留空 = 只通知，不排任务。
# ---------------------------------------------------------------------------
tasks: http://127.0.0.1:8283
workspace: /home/me/work/mail          # 邮件处理用的工作区（路径或工作区 id）
queue_followups: yes
