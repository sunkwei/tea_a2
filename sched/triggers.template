# 触发器的规则：哪些外部消息算「活儿」，哪些不算。
#
# 放在 ~/.tea_agent/triggers.conf（队列用 --trigger-config 指到别处也行）。
# 每个来源一段（[wechat]、[mail]、[webhook]……）：关键词用逗号分开；
# 写成 /.../ 就是正则（后面可以加 i 表示不区分大小写）。
#
# 规则先于模型：
#   * 命中 require —— 直接受理，不问模型（省钱，也稳）；
#   * 命中 ignore  —— 直接不管（优先级更高：「这条不是活儿」是明确的决定，
#                     而漏掉一条真活儿的代价比多问一句大）；
#   * 都没命中      —— 才问模型一次「这件事要不要做」。
#
# 文件改了会自动生效，不用重启队列。
#
# 例：
#   [wechat]
#   require = 修复, 部署, 报错
#   ignore = 早上好, 谢谢, 在吗
#
#   [mail]
#   require = /CI (failed|error)/i
#   ignore = 订阅, newsletter
#
#   [webhook]
#   # 这个来源的每一条都受理（要写成正则 /.../，光写 .* 是找字面量「.*」，
#   # 几乎永远不命中——那种情况下每一条都得问模型一次）
#   require = /.*/

# 聊天渠道（a2_telegram / a2_wechat 两个单元默认带 --triggers）：
# 白名单里的人跟 bot 说话通常就是有活儿干，所以全部受理（/.*/ 是正则，
# 匹配一切）——不为每条消息问一遍模型，既省钱又不会判错。
# 受理的触发器带一条「线索」（thread）：下一个任务知道之前发生过什么。
[telegram]
require = /.*/

[wechat]
require = /.*/
