# Build output
build/
build-*/
out/
cmake-build-*/

# Local toolchains downloaded for building/testing (see scripts/build-mingw.bat)
.toolchain/

# Scratch build temp (some sandboxes deny writes to the real %TEMP%)
.tmp/

# Release packages are **not** in git (2026-10-30): they are published to the
# Baidu Netdisk instead (sched/pan_publish.py). Keeping a 6-40 MB zip per
# version in the repo slows every clone and turns `git log` into noise.
# The build output stays local; the release zip lives in release/ and on the
# netdisk (/tea_a2/releases/<version>/).
# The whole directory: zips, exes, the buildinfo copy and the checksums are
# release artifacts that live on the netdisk, not in git.
release/

# A Windows repair script for this machine (integrity labels), not part of
# the product and not something a release package should carry.
scripts/restore-normal-integrity.cmd

# Editor / OS noise
.vscode/
.idea/
*.swp
*.bak
Thumbs.db
desktop.ini

# Local agent scratch space created inside a workspace
.tea_agent_run/

# Python bytecode: the queue and the WeChat bot are plain scripts, the
# interpreter compiles them on the machine that runs them.
__pycache__/
*.pyc

# Runtime logs
*.log
vcvars*.log

# Scratch space created by tests/e2e.ps1 and manual probing
tests/.scratch/
tests/.pc/
tests/.verify/
tests/.real/

# A build that relinked while the previous binary was still running keeps the old
# copy here for one build cycle (see cmake/free-running-exe.cmake)
*.prev-*

# The TURN account book the broker makes on its first start (it lives in the
# directory the broker is started from, which can be the repository)
a2_broker.db
# SQLite writes these two next to the book when it runs in WAL mode
a2_broker.db-shm
a2_broker.db-wal

clean/
