// resources/appstub.rc -- the application icon.
// The path is relative to this file.
#include <winver.h>

// The id has to be a number: an undefined identifier is taken by the resource
// compiler as a *name*, and LoadIcon(hInstance, MAKEINTRESOURCE(1)) would not
// find it then.
#define IDI_ICON1 1

IDI_ICON1 ICON "appstub.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "appstub - a tray host for other programs"
            VALUE "ProductName", "appstub"
            VALUE "FileVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
