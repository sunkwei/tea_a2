# Normalise line endings: LF inside the repository. Windows scripts keep CRLF
# so cmd.exe and PowerShell behave in the usual way when checked out.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.pem text
# Vendored sources stay byte-identical to upstream, so no checkout may rewrite
# their line endings: the sha256 recorded next to them has to keep matching.
3rd/** -text
