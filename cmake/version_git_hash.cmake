# Generate the git-hash accessor into the BUILD directory.
#
#   cmake -DREPO_DIR=<repo> -DOUTPUT=<build>/generated/version_git.cpp \
#         -P cmake/version_git_hash.cmake
#
# Why the build directory and not the source tree: the commit is build metadata,
# not source. Rewriting a tracked file to carry it meant that
#
#   * every build left the working tree dirty, so "git status" told you nothing
#     about *your* changes right after a build;
#   * the tree was then permanently "-dirty" (the file's own modification
#     counted), so the binary claimed a dirty state even after everything was
#     committed - the old script had to special-case its own file to work around
#     exactly that;
#   * two build trees (the native one and a cross build) wrote to one file.
#
# The generated file is written only when its content changes, so an unchanged
# commit does not force a recompile of the translation unit that includes it.
#
# Not a git repository (a release tarball) => "unknown".

if(NOT DEFINED REPO_DIR OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR
    "version_git_hash.cmake needs -DREPO_DIR=<dir> and -DOUTPUT=<file>")
endif()

execute_process(
  COMMAND git rev-parse --short=12 HEAD
  WORKING_DIRECTORY ${REPO_DIR}
  OUTPUT_VARIABLE _hash
  ERROR_QUIET
  RESULT_VARIABLE _rc
  OUTPUT_STRIP_TRAILING_WHITESPACE)

if(NOT _rc EQUAL 0 OR _hash STREQUAL "")
  set(_hash "unknown")
  set(_note "not a git repository")
else()
  # A dirty tree is not that commit. Mark it, or the binary claims a clean state
  # it does not have. The build directory is normally ignored by git; if it is
  # not, the tree really is dirty and saying so is correct.
  execute_process(
    COMMAND git status --porcelain
    WORKING_DIRECTORY ${REPO_DIR}
    OUTPUT_VARIABLE _dirty
    ERROR_QUIET
    RESULT_VARIABLE _dirty_rc
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(_dirty_rc EQUAL 0 AND NOT _dirty STREQUAL "")
    set(_hash "${_hash}-dirty")
  endif()
  set(_note "")
endif()

# string(CONCAT) and not set(): set() with several arguments builds a
# semicolon-separated LIST, which would turn every newline into a ";".
string(CONCAT _content
  "// Generated by cmake/version_git_hash.cmake - do not edit.\n"
  "//\n"
  "// The commit this binary was built from. Build metadata, so it lives in\n"
  "// the build directory and not in the source tree.\n"
  "\n"
  "namespace tea {\n"
  "const char* version_git_hash() {\n"
  "  return \"${_hash}\";\n"
  "}\n"
  "}  // namespace tea\n")

set(_existing "")
if(EXISTS ${OUTPUT})
  file(READ ${OUTPUT} _existing)
endif()
if(_existing STREQUAL _content)
  message(STATUS "git hash: ${_hash} (up to date)")
  return()
endif()

# Write through a temporary file and rename: two build trees compiling at the
# same time must never see a half-written file.
set(_tmp "${OUTPUT}.tmp")
file(WRITE ${_tmp} "${_content}")
file(RENAME ${_tmp} ${OUTPUT})
if(_note STREQUAL "")
  message(STATUS "git hash: ${_hash}")
else()
  message(STATUS "git hash: ${_hash} (${_note})")
endif()
