# provider.yaml.sample —— 模型怎么配
#
# 复制到 ~/.tea_agent/provider.yaml，改掉 key，重启 a2：
#
#     cp provider.yaml.sample ~/.tea_agent/provider.yaml
#     vi  ~/.tea_agent/provider.yaml
#
# 要改的就两处：api_url（地址）和 api_key（你的 key）。
# 不用管别的：providers 里第一个 provider 的第一个模型，就是 a2 默认用的。
#
# 别的设置不在这个文件里（每轮最多用几次工具、最多花多少 token、
# 能不能碰工作区外面的目录），在：
#     ~/.tea_agent/tea_agent.yaml                  机器级
#     <工作区>/.tea_agent_run/settings.yaml       按工作区，优先级更高
#
# 最小的一份：
#
#   providers:
#     my-model:
#       api_url: https://api.example.com/v1
#       api_key: sk-你的key
#       models:
#         some-model: {}
#
# 下面给了三种常见的写法。

version: 1

providers:
  # 1) DeepSeek
  deepseek:
    api_url: https://api.deepseek.com      # 不带 /v1 → 自动补 /v1/chat/completions
                                           # 带 /v1   → 自动补 /chat/completions
    api_key: sk-换成你的key
    # key 在 https://platform.deepseek.com/api_keys 拿
    models:
      deepseek-chat:
        max_context_tokens: 128000        # 上下文能有多长
        max_output_tokens: 8192            # 一次最多输出多少
        supports_tools: true               # 能不能调工具（agent 靠这个干活）
        supports_reasoning: false         # 有没有「思考」过程
        supports_vision: false            # 能不能看图

  # 2) MiniMax
  minimax:
    api_url: https://api.minimax.cn/v1
    api_key: sk-换成你的key
    models:
      MiniMax-M3.1-Flash:
        max_context_tokens: 1000000
        max_output_tokens: 128000
        supports_tools: true
        supports_reasoning: true
        supports_vision: true
        reasoning_effort: auto             # auto | low | medium | high

  # 3) 自己的网关、vLLM、硅基流动……任何 OpenAI 兼容的
  my-gateway:
    api_url: https://my-gateway.example.com/v1
    api_key: sk-换成你的key
    headers:                               # 网关要的自定义头（可省）
      x-some-header: value
    models:
      qwen-plus: {}
      # 模型名右边可以留空 {}，也可以像上面那样写全参数。

# 网页搜索和抓取用哪个 provider（可省；不写就用带 supports_search 的那个）。
# deepseek-chat 支持搜索和抓取。
search:
  provider: deepseek

# 排队任务用哪个 provider + 模型。格式：<provider>+<模型名>。改了不用重启，队列一分钟内自己看到。
task_model: deepseek+deepseek-chat

# 语音输入（可省）：装好 sched/asr_server.py 之后再填
# asr:
#   url: http://127.0.0.1:8284
